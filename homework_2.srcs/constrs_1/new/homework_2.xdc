create_clock -period 10.000 -name cp -waveform {0.000 5.000} [get_ports cp]
create_generated_clock -name cp_div_u/cp_div_reg_0 -source [get_ports cp] -divide_by 1 [get_pins cp_div_u/cp_div_reg/Q]
